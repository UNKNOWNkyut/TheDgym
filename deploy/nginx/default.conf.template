server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${SITE_DOMAIN} www.${SITE_DOMAIN};

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${SITE_DOMAIN};

    include /etc/nginx/snippets/ssl-params.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    return 301 https://${SITE_DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${SITE_DOMAIN};

    include /etc/nginx/snippets/ssl-params.conf;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    # Block hidden files/directories (.git, .env, etc.) while keeping .well-known
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Backend WebSocket live-feed (NFC scanner & portal push)
    location ^~ /api/access/ws/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # FastAPI endpoints, Xendit webhooks, and uploaded avatar files (/api/uploads/*)
    location ^~ /api/ {
        proxy_pass http://backend:8000;
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_read_timeout 60s;
    }

    # Hashed Vite JS/CSS bundles — safe to cache long-term
    location ~* ^/assets/.+-[A-Za-z0-9_-]{8}\.(?:js|css)$ {
        try_files $uri =404;
        expires 1y;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Other static media assets (images, logos, exercise GIFs, audio)
    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=604800" always;
    }

    # Crawl & manifest metadata must return 404 rather than falling back to index.html
    location ~ ^/(?:robots\.txt|sitemap\.xml|site\.webmanifest)$ {
        try_files $uri =404;
        expires 1h;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # SPA routes & HTML fallback (never cached aggressively)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src 'self' blob: https://accounts.google.com wss://${SITE_DOMAIN} ws://localhost:* wss://localhost:*; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header Cache-Control "no-cache" always;
    }
}
