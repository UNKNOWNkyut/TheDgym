# ============================================================================
# THE DGYM — PRODUCTION / STAGING DOCKER COMPOSE ENVIRONMENT TEMPLATE
# Copy to .env.prod on the server (`chmod 600 .env.prod`) and replace placeholders.
# ============================================================================

# Public domain & canonical frontend origin
SITE_DOMAIN=thedgym.com
VITE_SITE_URL=https://thedgym.com

# Backend environment gate ("staging" or "production")
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL credentials (keep POSTGRES_PASSWORD URL-safe, e.g. alphanumeric)
POSTGRES_DB=dgym_prod
POSTGRES_USER=dgym_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET_IN_PRODUCTION
JWT_ISSUER=thedgym-api
JWT_AUDIENCE=thedgym-client
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Explicit CORS origins (must match HTTPS domain; '*' forbidden in production)
CORS_ORIGINS=https://thedgym.com

# Docker Nginx bridge + loopback CIDRs permitted to supply X-Forwarded-For
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12

# Xendit (start with xnd_development_ test key; swap in live key & webhook token before launch)
XENDIT_SECRET_KEY=xnd_development_REPLACE_WITH_YOUR_KEY
XENDIT_WEBHOOK_VERIFICATION_TOKEN=REPLACE_WITH_XENDIT_CALLBACK_TOKEN

# Optional integrations
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
AUTO_SMS_ENABLED=false

# Automated backup retention window (days)
BACKUP_RETENTION_DAYS=14
