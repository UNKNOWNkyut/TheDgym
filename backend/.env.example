# ============================================================================
# THE DGYM — BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in real values before deploying to production
# ============================================================================

# REQUIRED: Application Environment ("development", "test", "staging", or "production")
# API refuses to boot if omitted. Only "development" auto-seeds demo users.
ENVIRONMENT=development

# Database Connection (SQLite default allowed only in development/test; PostgreSQL REQUIRED in production)
DATABASE_URL=sqlite+aiosqlite:///./dgym.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://dgym_user:STRONG_DB_PASSWORD@localhost:5432/dgym_prod

# JWT Cryptographic Secret (MUST be at least 32 random bytes outside development!)
# Generate one via: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET_IN_PRODUCTION
JWT_ISSUER=thedgym-api
JWT_AUDIENCE=thedgym-client
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Trusted reverse proxies (IPs or CIDRs) permitted to forward X-Forwarded-For client IPs
# Docker Compose production example: 127.0.0.1,::1,172.16.0.0/12
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Allowed Frontend Origins (comma-separated list; REQUIRED explicitly in production without '*')
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://thedgym.com,https://www.thedgym.com

# Optional: Google OAuth 2.0 Client ID (for "Sign in with Google")
GOOGLE_CLIENT_ID=

# Optional: OpenAI API Key (for GPT-4o-mini AI Retention Strategy Generation; falls back to heuristic engine if omitted)
OPENAI_API_KEY=

# Optional: TextBee Android SMS Gateway (https://textbee.dev) for SIM-routed Philippine SMS
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Keep disabled unless intentionally opting into automated domain SMS triggers
AUTO_SMS_ENABLED=false

# Xendit Payment Gateway API (https://xendit.co) for GCash, Maya, QR Ph, & Card online checkout
# Note: XENDIT_WEBHOOK_VERIFICATION_TOKEN is REQUIRED at startup when ENVIRONMENT=production
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
